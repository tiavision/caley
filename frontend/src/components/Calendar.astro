<article class="card contrast" style="max-width: 28rem;">
  <div id="calendar-grid"
       hx-get="/api/calendar"
       hx-trigger="htmx:afterSettle from:#calendar-container, calendarChange from:body"
       hx-target="#calendar-grid"
       hx-swap="innerHTML"
       hx-include="#calendar-form"
       style="min-height: 18rem;">
    <div class="calendar-loading">Loading calendar…</div>
  </div>
</article>

<style is:global>
  #calendar-grid .date-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
  }
  #calendar-grid div[data-month] hgroup h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  #calendar-grid div[data-month] [role="button"] {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: var(--pico-border-radius, 0.25rem);
    font-size: 1em;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  #calendar-grid div[data-month] [role="button"] .arrow {
    display: inline-block;
    transform: translateY(-0.08em);
  }
  #calendar-grid div[data-month] [role="button"]:hover,
  #calendar-grid div[data-month] [role="button"]:focus {
    background: var(--pico-contrast-border);
  }
  .date-cell {
    padding: 0.75rem 0.25rem;
    text-align: center;
    border-bottom: 1px solid;
    border-right: 1px solid;
    min-height: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .date-cell:nth-child(7n) {
    border-right: none;
  }
  .date-cell:nth-last-child(-n+7) {
    border-bottom: none;
  }
  .selected-week {
    background: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
    font-weight: 600;
  }
  .empty {
    background: transparent;
    cursor: default;
  }
  .date-cell.empty.selected-week {
    background: var(--pico-primary-background);
  }
  .event-dots {
    display: flex;
    justify-content: center;
    gap: 3px;
    margin-top: 3px;
  }
  .event-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .calendar-loading {
    display: none;
  }
  #calendar-grid.htmx-request .calendar-loading {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 1.5rem;
    font-style: italic;
    color: var(--pico-muted-color);
  }
  #calendar-grid.htmx-request .calendar-content .calendar-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  #calendar-grid.htmx-request .calendar-content {
    opacity: 0.3;
    transition: opacity 200ms ease-in;
  }
</style>

<script>
(function () {
  var today = new Date();
  today.setHours(0, 0, 0, 0);
  var selectedWeekStart = getMonday(today);

  var grid = document.getElementById('calendar-grid');

  function getMonday(d) {
    var date = new Date(d);
    var day = date.getDay();
    var diff = date.getDate() - day + (day === 0 ? -6 : 1);
    date.setDate(diff);
    date.setHours(0, 0, 0, 0);
    return date;
  }

  function formatDate(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  function formatMonth(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    return y + '-' + m;
  }

  function isSameMonth(a, b) {
    return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth();
  }

  function updateHiddenInputs() {
    var weekStartInput = document.getElementById('week-start-input');
    var weekEndInput = document.getElementById('week-end-input');
    if (!weekStartInput || !weekEndInput) return;
    var end = new Date(selectedWeekStart);
    end.setDate(end.getDate() + 6);
    weekStartInput.value = formatDate(selectedWeekStart);
    weekEndInput.value = formatDate(end);
  }

  function applyWeekHighlight() {
    var container = grid.querySelector('[data-month]');
    if (!container) return;
    var cells = container.querySelectorAll('[data-date]');
    var weekEnd = new Date(selectedWeekStart);
    weekEnd.setDate(weekEnd.getDate() + 6);
    weekEnd.setHours(23, 59, 59, 999);
    var startMs = selectedWeekStart.getTime();
    var endMs = weekEnd.getTime();

    container.querySelectorAll('.date-cell').forEach(function (c) {
      c.classList.remove('selected-week');
    });

    cells.forEach(function (cell) {
      var parts = cell.getAttribute('data-date').split('-');
      var cellDate = new Date(+parts[0], +parts[1] - 1, +parts[2]);
      cellDate.setHours(0, 0, 0, 0);
      var cellMs = cellDate.getTime();
      if (cellMs >= startMs && cellMs <= endMs) {
        cell.classList.add('selected-week');
      }
    });
  }

  function updateHxGet() {
    var monthEl = grid.querySelector('[data-month]');
    if (monthEl) {
      grid.setAttribute('hx-get', '/api/calendar?month=' + monthEl.getAttribute('data-month'));
    }
  }

  grid.addEventListener('click', function (e) {
    var cell = e.target.closest('[data-date]');
    if (!cell || cell.classList.contains('empty')) return;
    var parts = cell.getAttribute('data-date').split('-');
    var date = new Date(+parts[0], +parts[1] - 1, +parts[2]);
    selectedWeekStart = getMonday(date);
    applyWeekHighlight();
    updateHiddenInputs();
    var form = document.getElementById('calendar-form');
    if (form) {
      form.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'n' && e.key !== 'N' && e.key !== 'p' && e.key !== 'P') return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    var active = document.activeElement;
    if (active) {
      var tag = active.tagName.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || active.isContentEditable) return;
    }

    var dialog = document.getElementById('event-detail');
    if (dialog && dialog.open) return;

    e.preventDefault();

    var delta = 0;
    if (e.key === 'n') delta = 7;
    else if (e.key === 'N') delta = 28;
    else if (e.key === 'p') delta = -7;
    else if (e.key === 'P') delta = -28;

    selectedWeekStart.setDate(selectedWeekStart.getDate() + delta);
    updateHiddenInputs();

    var currentMonthEl = grid.querySelector('[data-month]');
    var currentMonth = currentMonthEl ? currentMonthEl.getAttribute('data-month') : null;

    if (currentMonth && isSameMonth(selectedWeekStart, new Date(currentMonth + '-01'))) {
      applyWeekHighlight();
    } else {
      var newMonth = formatMonth(selectedWeekStart);
      if (window.htmx) {
        window.htmx.ajax('GET', '/api/calendar?month=' + newMonth, { target: grid, swap: 'innerHTML', source: grid });
      }
    }

    var form = document.getElementById('calendar-form');
    if (form) {
      form.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  document.body.addEventListener('htmx:afterSettle', function (e) {
    if (e.detail.target && e.detail.target.id === 'calendar-grid') {
      updateHxGet();
      applyWeekHighlight();
      updateHiddenInputs();
    }
  });

  updateHiddenInputs();
})();
</script>

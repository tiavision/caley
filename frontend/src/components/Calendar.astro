<article class="card contrast" style="max-width: 28rem;">
  <header>
    <hgroup>
      <h2>
        <span id="prev-month" role="button" tabindex="0" aria-label="Previous month" style="cursor: pointer;">&lt;</span>
        <span id="month-title">January 2026</span>
        <span id="next-month" role="button" tabindex="0" aria-label="Next month" style="cursor: pointer;">></span>
      </h2>
      <p>Monthly calendar view</p>
    </hgroup>
  </header>
  <div role="grid" aria-label="Calendar">
    <div class="grid date-grid" role="row">
      <small>Mon</small><small>Tue</small><small>Wed</small>
      <small>Thu</small><small>Fri</small><small>Sat</small><small>Sun</small>
    </div>
    <div class="grid date-grid" id="date-grid" role="grid"></div>
  </div>
</article>

<style>
    .date-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0;
    }
    h2 {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    #prev-month, #next-month {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.5em;
      height: 1.5em;
      border-radius: var(--pico-border-radius, 0.25rem);
      font-size: 1em;
      line-height: 1;
      color: inherit;
      text-decoration: none;
      transition: background 0.15s;
    }
    #prev-month:hover, #next-month:hover,
    #prev-month:focus, #next-month:focus {
      background: var(--pico-contrast-border);
    }
</style>
<style is:global>
    .date-cell {
      padding: 0.75rem 0.25rem;
      text-align: center;
      border-bottom: 1px solid;
      border-right: 1px solid;
      min-height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .date-cell:nth-child(7n) {
      border-right: none;
    }
    .date-cell:nth-last-child(-n+7) {
      border-bottom: none;
    }
    .selected-week {
      background: var(--pico-primary-background);
      color: var(--pico-primary-inverse);
      font-weight: 600;
    }
    .empty {
      background: transparent;
      cursor: default;
    }
    .date-cell.empty.selected-week {
      background: var(--pico-primary-background);
    }
</style>

<script>
(function () {
  var viewedDate = new Date();
  viewedDate.setDate(1);
  viewedDate.setHours(0, 0, 0, 0);

  var today = new Date();
  today.setHours(0, 0, 0, 0);
  var selectedWeekStart = getMonday(today);

  var monthTitle = document.getElementById('month-title');
  var grid = document.getElementById('date-grid');
  var prevBtn = document.getElementById('prev-month');
  var nextBtn = document.getElementById('next-month');

  function getMonday(d) {
    var date = new Date(d);
    var day = date.getDay();
    var diff = date.getDate() - day + (day === 0 ? -6 : 1);
    date.setDate(diff);
    date.setHours(0, 0, 0, 0);
    return date;
  }

  function addMonths(date, months) {
    var result = new Date(date);
    result.setMonth(result.getMonth() + months);
    if (result.getDate() !== date.getDate()) {
      result.setDate(0);
    }
    return result;
  }

  function formatMonthYear(date) {
    return date.toLocaleDateString(navigator.language, { month: 'long', year: 'numeric' });
  }

  function formatDate(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  function render() {
    var year = viewedDate.getFullYear();
    var month = viewedDate.getMonth();
    var firstDay = new Date(year, month, 1);
    var daysInMonth = new Date(year, month + 1, 0).getDate();

    var startOffset = firstDay.getDay() - 1;
    if (startOffset < 0) startOffset = 6;
    var totalCells = Math.ceil((startOffset + daysInMonth) / 7) * 7;

    monthTitle.textContent = formatMonthYear(viewedDate);
    grid.setAttribute('aria-label', 'Calendar for ' + formatMonthYear(viewedDate));
    grid.innerHTML = '';

    var weekEnd = new Date(selectedWeekStart);
    weekEnd.setDate(weekEnd.getDate() + 6);
    weekEnd.setHours(23, 59, 59, 999);
    var weekStartMs = selectedWeekStart.getTime();
    var weekEndMs = weekEnd.getTime();

    for (var i = 0; i < totalCells; i++) {
      var cell = document.createElement('div');
      cell.className = 'date-cell';

      var dayOffset = i - startOffset + 1;
      var cellDate = new Date(year, month, dayOffset);
      cellDate.setHours(0, 0, 0, 0);
      var isCurrentMonth = dayOffset > 0 && dayOffset <= daysInMonth;

      if (!isCurrentMonth) {
        cell.classList.add('empty');
      } else {
        cell.textContent = dayOffset;
      }

      var cellMs = cellDate.getTime();
      if (cellMs >= weekStartMs && cellMs <= weekEndMs) {
        cell.classList.add('selected-week');
      }

      if (isCurrentMonth) {
        cell.style.cursor = 'pointer';
        cell.addEventListener('click', (function (d) {
          return function () { selectWeek(d); };
        })(cellDate));
      }

      grid.appendChild(cell);
    }
  }

  function updateHiddenInputs() {
    var weekStartInput = document.getElementById('week-start-input');
    var weekEndInput = document.getElementById('week-end-input');
    if (!weekStartInput || !weekEndInput) return;
    var end = new Date(selectedWeekStart);
    end.setDate(end.getDate() + 6);
    weekStartInput.value = formatDate(selectedWeekStart);
    weekEndInput.value = formatDate(end);
  }

  function selectWeek(date) {
    selectedWeekStart = getMonday(date);
    render();
    updateHiddenInputs();
    var form = document.getElementById('calendar-form');
    if (form) {
      form.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  function navigateMonth(delta) {
    viewedDate = addMonths(viewedDate, delta);
    render();
  }

  prevBtn.addEventListener('click', function () { navigateMonth(-1); });
  nextBtn.addEventListener('click', function () { navigateMonth(1); });

  prevBtn.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigateMonth(-1); }
  });
  nextBtn.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigateMonth(1); }
  });

  render();
  updateHiddenInputs();
})();
</script>

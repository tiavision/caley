function updateIntervalUnit() {
  var freq = document.getElementById('event-form-freq').value;
  var unitEl = document.getElementById('event-form-interval-unit');
  var tr = window.__i18n ? window.__i18n.t : function(k) { return k; };
  var map = { DAILY: tr('event.repeatUnitDaily'), WEEKLY: tr('event.repeatUnitWeekly'), MONTHLY: tr('event.repeatUnitMonthly'), YEARLY: tr('event.repeatUnitYearly') };
  unitEl.textContent = map[freq] || '';
}

function updateEndFields() {
  var et = document.getElementById('event-form-end-type').value;
  document.getElementById('event-form-end-count').style.display = et === 'count' ? '' : 'none';
  document.getElementById('event-form-end-until').style.display = et === 'until' ? '' : 'none';
}

function updateRecurrenceVisibility() {
  var freq = document.getElementById('event-form-freq').value;
  document.getElementById('event-form-rrule-options').style.display = freq ? '' : 'none';
  document.getElementById('event-form-byday-field').style.display = freq === 'WEEKLY' ? '' : 'none';
  document.getElementById('event-form-monthly-field').style.display = freq === 'MONTHLY' ? '' : 'none';
  updateIntervalUnit();
  updateEndFields();
}

function buildRecurrenceJson() {
  var freq = document.getElementById('event-form-freq').value;
  if (!freq) return '';
  var obj = {
    freq: freq,
    interval: parseInt(document.getElementById('event-form-interval').value) || 1,
    by_day: [],
    by_month_day: [],
    by_month: [],
    by_set_pos: [],
    until: null,
    count: null
  };
  if (freq === 'WEEKLY') {
    document.querySelectorAll('#event-form-byday-field input[type="checkbox"]:checked').forEach(function(cb) {
      obj.by_day.push(cb.value);
    });
  }
  if (freq === 'MONTHLY') {
    var mode = document.querySelector('input[name="monthly_mode"]:checked');
    if (mode && mode.value === 'by_setpos') {
      var pos = parseInt(document.getElementById('event-form-setpos').value);
      var day = document.getElementById('event-form-setpos-day').value;
      if (pos) obj.by_set_pos = [pos];
      if (day) obj.by_day = [day];
    } else {
      var d = parseInt(document.getElementById('event-form-monthday').value);
      if (d) obj.by_month_day = [d];
    }
  }
  var et = document.getElementById('event-form-end-type').value;
  if (et === 'count') {
    var c = parseInt(document.getElementById('event-form-count').value);
    if (c) obj.count = c;
  } else if (et === 'until') {
    obj.until = document.getElementById('event-form-until').value || null;
  }
  return JSON.stringify(obj);
}

function populateRecurrenceFields(jsonStr) {
  var rec = {};
  try { rec = JSON.parse(jsonStr); } catch(e) {}
  var freq = rec.freq || '';
  document.getElementById('event-form-freq').value = freq;
  if (!freq) { resetRecurrenceFields(); return; }
  document.getElementById('event-form-rrule-options').style.display = '';
  document.getElementById('event-form-interval').value = rec.interval || 1;
  updateIntervalUnit();
  // Weekly days
  if (freq === 'WEEKLY') {
    document.getElementById('event-form-byday-field').style.display = '';
    document.querySelectorAll('#event-form-byday-field input[type="checkbox"]').forEach(function(cb) {
      cb.checked = rec.by_day && rec.by_day.indexOf(cb.value) !== -1;
    });
  } else {
    document.getElementById('event-form-byday-field').style.display = 'none';
  }
  // Monthly mode
  if (freq === 'MONTHLY') {
    document.getElementById('event-form-monthly-field').style.display = '';
    if (rec.by_set_pos && rec.by_set_pos.length > 0) {
      document.querySelectorAll('input[name="monthly_mode"]').forEach(function(r) { r.checked = r.value === 'by_setpos'; });
      document.getElementById('event-form-setpos').value = String(rec.by_set_pos[0]);
      if (rec.by_day && rec.by_day.length > 0) document.getElementById('event-form-setpos-day').value = rec.by_day[0];
    } else {
      document.querySelectorAll('input[name="monthly_mode"]').forEach(function(r) { r.checked = r.value === 'by_day'; });
      if (rec.by_month_day && rec.by_month_day.length > 0) document.getElementById('event-form-monthday').value = rec.by_month_day[0];
    }
  } else {
    document.getElementById('event-form-monthly-field').style.display = 'none';
  }
  // End condition
  if (rec.count) {
    document.getElementById('event-form-end-type').value = 'count';
    document.getElementById('event-form-count').value = rec.count;
  } else if (rec.until) {
    document.getElementById('event-form-end-type').value = 'until';
    document.getElementById('event-form-until').value = rec.until.split(' ')[0];
  } else {
    document.getElementById('event-form-end-type').value = 'never';
  }
  updateEndFields();
  document.getElementById('event-form-recurrence').value = buildRecurrenceJson();
}


<div class="weekly-header">
  <h2 data-i18n="weekly.heading">Weekly Calendar</h2>
  <span id="week-range-display"></span>
</div>
    
    <div id="weekly-events" class="calendar" style="position: relative"
         role="grid" aria-label="Weekly calendar"
         hx-get="/api/events"
         hx-trigger="htmx:afterSettle from:#calendar-container, change from:#calendar-form"
         hx-include="#calendar-form"
         hx-swap="innerHTML">
        <div class="week-loading" data-i18n="weekly.loading">Loading events</div>
    </div>

<dialog id="event-detail">
  <article>
    <header>
      <h3 id="event-detail-summary"></h3>
      <div class="header-actions">
        <button id="event-detail-edit" class="edit-btn" title="Edit" data-i18n-attr="title:event.edit">&#9998;</button>
        <button id="event-detail-close" class="close-btn" data-i18n-attr="aria-label:weekly.aria.close" aria-label="Close">&times;</button>
      </div>
    </header>
    <div id="edit-choice-popover" class="edit-choice-popover" style="display:none">
      <button id="edit-choice-series" data-i18n="event.editSeries">Edit the series</button>
      <button id="edit-choice-instance" data-i18n="event.editInstance">Edit this instance</button>
    </div>
    <div class="event-detail-body">
      <div class="event-detail-row" id="event-detail-time-row">
        <span class="event-detail-label" data-i18n="event.time">Time</span>
        <span id="event-detail-time"></span>
      </div>
      <div class="event-detail-row" id="event-detail-location-row">
        <span class="event-detail-label" data-i18n="event.location">Location</span>
        <span id="event-detail-location"></span>
      </div>
      <div class="event-detail-row" id="event-detail-recurrence-row">
        <span class="event-detail-label" data-i18n="event.repeats">Repeats</span>
        <span id="event-detail-recurrence"></span>
      </div>
      <div id="event-detail-description-row">
        <span class="event-detail-label" data-i18n="event.description">Description</span>
        <p id="event-detail-description"></p>
      </div>
    </div>
  </article>
</dialog>

<dialog id="event-form">
  <article>
    <header>
      <h3 id="event-form-title" data-i18n="event.create">New Event</h3>
      <button id="event-form-close" class="close-btn" data-i18n-attr="aria-label:weekly.aria.close" aria-label="Close">&times;</button>
    </header>
    <div id="event-form-result"></div>
    <form id="event-form-form" hx-post="/api/event" hx-target="#event-form-result" hx-swap="innerHTML">
      <input type="hidden" name="uid" id="event-form-uid" value="">
      <input type="hidden" name="original_dtstart" id="event-form-original-dtstart" value="">
      <input type="hidden" name="scope" id="event-form-scope" value="series">
      <input type="hidden" name="tz" id="event-form-tz" value="UTC">

      <label>
        <span data-i18n="event.summary">Summary</span>
        <input type="text" name="summary" id="event-form-summary" required>
      </label>
      <label>
        <span data-i18n="event.date">Date</span>
        <input type="date" name="date" id="event-form-date" required>
      </label>
      <label class="all-day-label">
        <input type="checkbox" name="is_all_day" id="event-form-all-day" value="true">
        <span data-i18n="event.allDay">All day</span>
      </label>
      <div id="event-form-time-fields" class="time-fields">
        <label>
          <span data-i18n="event.startTime">Start time</span>
          <input type="time" name="start_time" id="event-form-start-time">
        </label>
        <label>
          <span data-i18n="event.endTime">End time</span>
          <input type="time" name="end_time" id="event-form-end-time">
        </label>
      </div>
      <label>
        <span data-i18n="event.location">Location</span>
        <input type="text" name="location" id="event-form-location">
      </label>
      <label>
        <span data-i18n="event.description">Description</span>
        <textarea name="description" id="event-form-description" rows="3"></textarea>
      </label>
      <label>
        <span data-i18n="event.calendar">Calendar</span>
        <select name="calendar_href" id="event-form-calendar-select"></select>
      </label>
      <div class="event-form-actions">
        <button type="submit" data-i18n="event.save">Save</button>
        <button type="button" class="secondary" id="event-form-cancel" data-i18n="event.cancel">Cancel</button>
        <button type="button" class="contrast outline" id="event-form-delete" style="display:none" data-i18n="event.delete">Delete</button>
      </div>
    </form>
  </article>
</dialog>

<button id="fab-new-event" class="fab" aria-label="New event" data-i18n-attr="aria-label:event.new" title="New event">
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="12" y1="5" x2="12" y2="19"></line>
    <line x1="5" y1="12" x2="19" y2="12"></line>
  </svg>
</button>

<script>
function formatRecurrence(r, locale) {
  if (!r || !r.freq) return '';
  const t = window.__i18n ? window.__i18n.t : (k) => k;
  const singular = { DAILY: 'rec.everyDay', WEEKLY: 'rec.everyWeek', MONTHLY: 'rec.everyMonth', YEARLY: 'rec.everyYear' };
  const plural = { DAILY: 'rec.everyNDays', WEEKLY: 'rec.everyNWeeks', MONTHLY: 'rec.everyNMonths', YEARLY: 'rec.everyNYears' };
  const dayNames = { MO: 0, TU: 1, WE: 2, TH: 3, FR: 4, SA: 5, SU: 6 };
  const interval = r.interval && r.interval > 1 ? r.interval : 1;
  let text = '';
  if (interval === 1) {
    text += t(singular[r.freq]);
  } else {
    text += t(plural[r.freq]).replace('{n}', interval);
  }
  if (r.by_day && r.by_day.length > 0 && r.freq === 'WEEKLY') {
    const dtf = new Intl.DateTimeFormat(locale, { weekday: 'long' });
    const refDate = new Date(2024, 0, 1);
    const dayFn = (code) => {
      const jsDay = dayNames[code];
      if (jsDay === undefined) return code;
      refDate.setDate(1 + jsDay);
      return dtf.format(refDate);
    };
    text += t('rec.on') + r.by_day.map(dayFn).join(', ');
  }
  if (r.by_month_day && r.by_month_day.length > 0 && r.freq === 'MONTHLY') {
    text += t('rec.onDay') + r.by_month_day.join(', ');
  }
  if (r.count) {
    text += ', ' + r.count + t('rec.times');
  } else if (r.until) {
    const untilDate = new Date(r.until + 'Z');
    if (!isNaN(untilDate.getTime())) {
      text += t('rec.until') + untilDate.toLocaleDateString(locale, { dateStyle: 'long' });
    }
  }
  return text;
}

function openEventDetail(article) {
  const dialog = document.getElementById('event-detail');
  const locale = navigator.language || 'en';

  const summary = article.getAttribute('data-summary') || '';
  const dtstart = article.getAttribute('data-dtstart') || '';
  const dtend = article.getAttribute('data-dtend') || '';
  const tz = article.getAttribute('data-tz') || '';
  const isAllDay = article.getAttribute('data-is-all-day') === 'true';
  const location = article.getAttribute('data-location') || '';
  const description = article.getAttribute('data-description') || '';
  const isRecurring = article.getAttribute('data-is-recurring') === 'true';
  const recurrenceRaw = article.getAttribute('data-recurrence') || '{}';
  let recurrence = null;
  try { recurrence = JSON.parse(recurrenceRaw); } catch(e) { recurrence = null; }

  document.getElementById('event-detail-summary').textContent = summary;

  let timeText = '';
  const tr = window.__i18n ? window.__i18n.t : (k) => k;
  if (isAllDay) {
    timeText = tr('event.allDay') + (dtstart ? ' \u00B7 ' + new Date(dtstart + 'T00:00:00').toLocaleDateString(locale, { dateStyle: 'long' }) : '');
  } else if (dtstart) {
    const s = new Date(dtstart.includes('Z') || dtstart.includes('+') ? dtstart : dtstart + 'Z');
    const dateStr = s.toLocaleDateString(locale, { dateStyle: 'long' });
    const timeStr = s.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
    timeText = dateStr + ', ' + timeStr;
    if (dtend) {
      const e = new Date(dtend.includes('Z') || dtend.includes('+') ? dtend : dtend + 'Z');
      const endSameDay = s.toDateString() === e.toDateString();
      if (endSameDay) {
        timeText += ' \u2013 ' + e.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
      } else {
        timeText += ' \u2013 ' + e.toLocaleDateString(locale, { dateStyle: 'long' }) + ', ' + e.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
      }
    }
    if (tz && tz !== 'UTC') timeText += ' (' + tz + ')';
  }
  document.getElementById('event-detail-time').textContent = timeText;
  document.getElementById('event-detail-time-row').style.display = timeText ? '' : 'none';

  const locEl = document.getElementById('event-detail-location');
  locEl.textContent = location;
  document.getElementById('event-detail-location-row').style.display = location ? '' : 'none';

  const recText = isRecurring ? formatRecurrence(recurrence, locale) : '';
  const recEl = document.getElementById('event-detail-recurrence');
  recEl.textContent = recText;
  document.getElementById('event-detail-recurrence-row').style.display = recText ? '' : 'none';

  const descEl = document.getElementById('event-detail-description');
  descEl.textContent = description;
  document.getElementById('event-detail-description-row').style.display = description ? '' : 'none';

  _currentEventArticle = article;
  dialog.showModal();
}

function setupEventDetailListeners() {
  document.querySelectorAll('.event-trigger').forEach(el => {
    el.removeEventListener('click', el._eventDetailHandler);
    el.removeEventListener('keydown', el._eventDetailKeyHandler);
    el._eventDetailHandler = () => openEventDetail(el);
    el._eventDetailKeyHandler = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openEventDetail(el); } };
    el.addEventListener('click', el._eventDetailHandler);
    el.addEventListener('keydown', el._eventDetailKeyHandler);
  });
}

document.getElementById('event-detail-close').addEventListener('click', () => {
  document.getElementById('event-detail').close();
});

document.getElementById('event-detail').addEventListener('click', (e) => {
  if (e.target === e.currentTarget) e.currentTarget.close();
});

setupEventDetailListeners();
document.addEventListener('htmx:afterSettle', setupEventDetailListeners);

var _currentEventArticle = null;

document.getElementById('event-detail-edit').addEventListener('click', function() {
  var article = _currentEventArticle;
  if (!article) return;
  var isRecurring = article.getAttribute('data-is-recurring') === 'true';
  if (isRecurring) {
    var popover = document.getElementById('edit-choice-popover');
    var rect = document.getElementById('event-detail-edit').getBoundingClientRect();
    popover.style.top = (rect.bottom + 4) + 'px';
    popover.style.left = rect.left + 'px';
    popover.style.display = 'flex';
  } else {
    openEventForm(article, 'series');
  }
});

document.addEventListener('click', function(e) {
  var popover = document.getElementById('edit-choice-popover');
  if (popover && popover.style.display !== 'none' && !popover.contains(e.target) && e.target.id !== 'event-detail-edit') {
    popover.style.display = 'none';
  }
});

document.getElementById('edit-choice-series').addEventListener('click', function() {
  var article = _currentEventArticle;
  document.getElementById('edit-choice-popover').style.display = 'none';
  if (article) openEventForm(article, 'series');
});

document.getElementById('edit-choice-instance').addEventListener('click', function() {
  var article = _currentEventArticle;
  document.getElementById('edit-choice-popover').style.display = 'none';
  if (article) openEventForm(article, 'this_instance');
});

function populateCalendarSelect() {
  var select = document.getElementById('event-form-calendar-select');
  if (!select) return;
  select.innerHTML = '';
  var container = document.getElementById('calendar-container');
  if (!container) return;
  container.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
    var raw = cb.value;
    var href = raw.split('|')[0] || raw;
    var label = container.querySelector('label[for="' + cb.id + '"]');
    var name = label ? label.textContent.trim() : href;
    var option = document.createElement('option');
    option.value = href;
    option.textContent = name;
    select.appendChild(option);
  });
}

function openEventForm(article, scope) {
  var dialog = document.getElementById('event-form');
  var isAllDay = article.getAttribute('data-is-all-day') === 'true';
  var dtstart = article.getAttribute('data-dtstart') || '';
  var dtend = article.getAttribute('data-dtend') || '';
  var tz = article.getAttribute('data-tz') || 'UTC';

  document.getElementById('event-form-uid').value = article.getAttribute('data-uid') || '';
  document.getElementById('event-form-summary').value = article.getAttribute('data-summary') || '';
  document.getElementById('event-form-location').value = article.getAttribute('data-location') || '';
  document.getElementById('event-form-description').value = article.getAttribute('data-description') || '';
  document.getElementById('event-form-tz').value = tz;
  document.getElementById('event-form-scope').value = scope || 'series';
  document.getElementById('event-form-original-dtstart').value = dtstart;

  var datePart = dtstart.split('T')[0] || '';
  document.getElementById('event-form-date').value = datePart;

  if (isAllDay) {
    document.getElementById('event-form-all-day').checked = true;
    document.getElementById('event-form-time-fields').classList.add('hidden');
    document.getElementById('event-form-start-time').value = '';
    document.getElementById('event-form-end-time').value = '';
  } else {
    document.getElementById('event-form-all-day').checked = false;
    document.getElementById('event-form-time-fields').classList.remove('hidden');
    var startParts = dtstart.match(/T(\d{2}:\d{2})/);
    document.getElementById('event-form-start-time').value = startParts ? startParts[1] : '';
    if (dtend) {
      var endParts = dtend.match(/T(\d{2}:\d{2})/);
      document.getElementById('event-form-end-time').value = endParts ? endParts[1] : '';
    }
  }

  document.getElementById('event-form').setAttribute('data-mode', 'edit');
  document.getElementById('event-form-title').textContent = window.__i18n ? window.__i18n.t('event.edit') : 'Edit event';
  document.getElementById('event-form-delete').style.display = '';
  populateCalendarSelect();
  document.getElementById('event-form-calendar-select').value = article.getAttribute('data-calendar-href') || '';

  document.getElementById('event-detail').close();
  document.getElementById('event-form-result').innerHTML = '';
  dialog.showModal();
}

function openNewEventForm() {
  var dialog = document.getElementById('event-form');
  document.getElementById('event-form-uid').value = '';
  document.getElementById('event-form-summary').value = '';
  document.getElementById('event-form-location').value = '';
  document.getElementById('event-form-description').value = '';
  document.getElementById('event-form-tz').value = 'UTC';
  document.getElementById('event-form-scope').value = 'series';
  document.getElementById('event-form-original-dtstart').value = '';
  document.getElementById('event-form-all-day').checked = false;
  document.getElementById('event-form-time-fields').classList.remove('hidden');
  document.getElementById('event-form-start-time').value = '';
  document.getElementById('event-form-end-time').value = '';
  document.getElementById('event-form-delete').style.display = 'none';

  var startInput = document.getElementById('week-start-input');
  var dateVal = '';
  if (startInput && startInput.value) {
    dateVal = startInput.value;
  } else {
    dateVal = new Date().toISOString().split('T')[0];
  }
  document.getElementById('event-form-date').value = dateVal;

  document.getElementById('event-form-title').textContent = window.__i18n ? window.__i18n.t('event.create') : 'New event';
  populateCalendarSelect();
  var firstOpt = document.getElementById('event-form-calendar-select').options[0];
  if (firstOpt) document.getElementById('event-form-calendar-select').value = firstOpt.value;

  document.getElementById('event-form-result').innerHTML = '';
  dialog.showModal();
}

document.getElementById('event-form-all-day').addEventListener('change', function() {
  var fields = document.getElementById('event-form-time-fields');
  if (this.checked) {
    fields.classList.add('hidden');
  } else {
    fields.classList.remove('hidden');
  }
});

document.getElementById('event-form-close').addEventListener('click', function() {
  document.getElementById('event-form').close();
});

document.getElementById('event-form-cancel').addEventListener('click', function() {
  document.getElementById('event-form').close();
});

document.getElementById('event-form').addEventListener('click', function(e) {
  if (e.target === e.currentTarget) this.close();
});

document.addEventListener('htmx:afterRequest', function(evt) {
  if (evt.detail.target && evt.detail.target.id === 'event-form-result') {
    if (evt.detail.successful) {
      document.getElementById('event-form').close();
    }
  }
});

document.getElementById('event-form-delete').addEventListener('click', function() {
  var uid = document.getElementById('event-form-uid').value;
  var href = document.getElementById('event-form-calendar-select').value;
  if (!uid || !href) return;
  var msg = window.__i18n ? window.__i18n.t('event.deleteConfirm') : 'Delete this event?';
  if (!confirm(msg)) return;
  var xhr = new XMLHttpRequest();
  xhr.open('DELETE', '/api/event?uid=' + encodeURIComponent(uid) + '&calendar_href=' + encodeURIComponent(href), true);
  xhr.onload = function() {
    if (xhr.status >= 200 && xhr.status < 300) {
      document.getElementById('event-form').close();
      var body = document.body;
      var event = new CustomEvent('calendarChange');
      body.dispatchEvent(event);
    }
  };
  xhr.send();
});

document.getElementById('fab-new-event').addEventListener('click', openNewEventForm);

(function updateWeekRange() {
  var display = document.getElementById('week-range-display');
  if (!display) return;

  function update() {
    var startInput = document.getElementById('week-start-input');
    var endInput = document.getElementById('week-end-input');
    if (!startInput || !endInput || !startInput.value || !endInput.value) return;

    var locale = navigator.language || 'en';
    var start = new Date(startInput.value + 'T00:00:00');
    var end = new Date(endInput.value + 'T00:00:00');
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return;

    var today = new Date();
    var currentYear = today.getFullYear();
    var startYear = start.getFullYear();
    var endYear = end.getFullYear();

    var startOpts = { month: 'short', day: 'numeric' };
    var endOpts = { month: 'short', day: 'numeric' };

    if (startYear !== currentYear) {
      startOpts.year = 'numeric';
    }
    if (endYear !== currentYear || startYear !== endYear) {
      endOpts.year = 'numeric';
    }

    display.textContent = start.toLocaleDateString(locale, startOpts) + ' \u2013 ' + end.toLocaleDateString(locale, endOpts);
  }

  var form = document.getElementById('calendar-form');
  if (form) {
    form.addEventListener('change', update);
  }
  document.addEventListener('htmx:afterSettle', update);
  update();
})();

(function initGridKeyboard() {
  var grid = document.getElementById('weekly-events');
  if (!grid) return;

  function getGridModel() {
    return Array.from(grid.querySelectorAll('.day'))
      .map(function(day) { return Array.from(day.querySelectorAll('.appointment.event-trigger')); })
      .filter(function(col) { return col.length > 0; });
  }

  function initRovingTabindex() {
    var found = false;
    grid.querySelectorAll('.appointment.event-trigger').forEach(function(el) {
      if (!found) { el.setAttribute('tabindex', '0'); found = true; }
      else { el.setAttribute('tabindex', '-1'); }
    });
  }

  grid.addEventListener('keydown', function(e) {
    if (document.getElementById('event-detail') && document.getElementById('event-detail').open) return;
    var target = e.target;
    if (!target.classList || !target.classList.contains('event-trigger')) return;

    var model = getGridModel();
    if (model.length === 0) return;

    var col = -1, row = -1;
    for (var c = 0; c < model.length; c++) {
      var r = model[c].indexOf(target);
      if (r !== -1) { col = c; row = r; break; }
    }
    if (col === -1) return;

    var nextCol = col, nextRow = row, moved = false;

    switch (e.key) {
      case 'ArrowLeft':
        if (col > 0) { nextCol = col - 1; nextRow = Math.min(row, model[nextCol].length - 1); moved = true; }
        break;
      case 'ArrowRight':
        if (col < model.length - 1) { nextCol = col + 1; nextRow = Math.min(row, model[nextCol].length - 1); moved = true; }
        break;
      case 'ArrowUp':
        if (row > 0) { nextRow = row - 1; moved = true; }
        break;
      case 'ArrowDown':
        if (row < model[col].length - 1) { nextRow = row + 1; moved = true; }
        break;
      default:
        return;
    }

    if (moved) {
      e.preventDefault();
      var next = model[nextCol][nextRow];
      grid.querySelectorAll('.appointment.event-trigger').forEach(function(el) { el.setAttribute('tabindex', '-1'); });
      next.setAttribute('tabindex', '0');
      next.focus();
    }
  });

  initRovingTabindex();
  document.addEventListener('htmx:afterSettle', initRovingTabindex);
})();
</script>


<style>
.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.5rem;
}

@media (max-width: 1024px) {
  .calendar {
    grid-template-columns: 1fr;
  }
}

.weekly-header {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 0.5rem;
}
#week-range-display {
  font-size: 0.875rem;
  color: var(--pico-muted-color);
}

.dot {
  border-radius: 50%;
  width: 10px;
  height:10px;
  display:inline-block
}
</style>

<style is:global>
article {
  margin-bottom: 0.5rem !important;
  font-size: medium;

  &.appointment {
    p {
      margin-bottom: 0.125rem;
    }
    header {
      font-size: small;
    }
  }
}

.event-trigger {
  cursor: pointer;
  transition: filter 0.15s ease;
}
.event-trigger:hover {
  filter: brightness(0.95);
}
.event-trigger:focus-visible {
  outline: 2px solid var(--pico-primary-background, #0074d9);
  outline-offset: 2px;
}

#event-detail {
  border: 1px solid var(--pico-muted-border-color, #c8c8c8);
  border-radius: var(--pico-border-radius, 0.25rem);
  padding: 0;
  max-width: 28rem;
  width: 90vw;
  background: var(--pico-background-color, #fff);
  color: var(--pico-color, #333);
  box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.25);
}

#event-detail::backdrop {
  background: rgba(0,0,0,0.4);
}

#event-detail article {
  margin: 0;
  padding: 1.5rem;
}

#event-detail article header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
}

#event-detail article header h3 {
  margin: 0;
  flex: 1;
  word-break: break-word;
}

.close-btn {
  position: relative;
  background: none;
  border: none;
  font-size: 1.5rem;
  line-height: 1;
  padding: 0;
  width: 1.2em;
  height: 1.2em;
  cursor: pointer;
  color: transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.close-btn::before,
.close-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0.75em;
  height: 0.1em;
  background-color: var(--pico-muted-color, #666);
  transition: background-color 0.15s;
}
.close-btn::before {
  transform: translate(-50%, -50%) rotate(45deg);

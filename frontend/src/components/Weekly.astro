}

function autoFillEndTime() {
  var endInput = document.getElementById('event-form-end-time');
  if (endInput.value) return;
  var startInput = document.getElementById('event-form-start-time');
  if (!startInput.value) return;
  var parts = startInput.value.split(':');
  var totalMin = parseInt(parts[0]) * 60 + parseInt(parts[1]) + 30;
  var h = Math.floor(totalMin / 60) % 24;
  var m = totalMin % 60;
  endInput.value = String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
}


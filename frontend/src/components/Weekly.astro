  document.getElementById('event-form-delete').style.display = 'none';
  document.getElementById('event-form-original-calendar-href').value = '';
  document.getElementById('event-form-calendar-select').disabled = false;

  var startInput = document.getElementById('week-start-input');
  var dateVal = '';


<h2 data-i18n="cal.heading">Calendars</h2>
<form id="calendar-form">
	<input type="hidden" name="start" id="week-start-input">
	<input type="hidden" name="end" id="week-end-input">
	<div id="calendar-container" hx-get="/api/calendars" hx-trigger="load" hx-swap="innerHTML">
		<p data-i18n="cal.loading">Loading calendars…</p>
	</div>
</form>

<script>
(function () {
  document.getElementById('calendar-form').addEventListener('change', function (e) {
    if (e.target.type === 'checkbox' && e.target.name === 'cal') {
      var val = e.target.value;
      var href = val.split('|')[0];
      var active = e.target.checked;
      fetch('/api/calendar/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'href=' + encodeURIComponent(href) + '&active=' + (active ? 'true' : 'false')
      });
      document.body.dispatchEvent(new CustomEvent('calendarChange'));
    }
  });
})();
</script>

<style is:global>
.calendar-list {
	padding: 0;

	li {
		list-style: none;
	}
}

.calendar-list input[type="checkbox"] {
	cursor: pointer;
}

.dot {
	border-radius: 50%;
	width: 10px;
	height:10px;
	display:inline-block
}
</style>
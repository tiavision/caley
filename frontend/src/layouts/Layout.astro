---
import '../styles/main.scss';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title data-i18n="app.title">Caley</title>
		<script>
			import htmx from 'htmx.org';
			window.htmx = htmx;
		</script>
		<style>
			a.brand {
				color: inherit;
				text-decoration: none;
			}
		</style>
		<script>
			import { initI18n, t, setLocale, getLang } from '../i18n/index.ts';
			initI18n();
			window.__i18n = { t, setLocale, getLang };
		</script>
	</head>
	<body>
		<header class="container">
			<nav>
				<ul><li><a href="/" class="brand"><strong data-i18n="app.brand">Caley</strong></a></li></ul>
			<ul>
				<li hx-get="/api/user" hx-trigger="load" hx-swap="innerHTML"><span data-i18n="nav.loading">Loading...</span></li>
			</ul>
			</nav>
		</header>
		<main class="container">
			<slot />
		</main>
	</body>
</html>

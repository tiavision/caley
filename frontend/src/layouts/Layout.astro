---
import '../styles/main.scss';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title data-i18n="app.title">Caley</title>
		<style is:global>
			a.brand {
				color: inherit;
				text-decoration: none;
			}
			#nav-user-list li {
				padding: 0 0.25rem;
			}
			#nav-user-list li + li::before {
				content: "|";
				margin-right: 0.5rem;
				opacity: 0.4;
			}
			#nav-user-list li:not(:has(a)) {
				font-weight: 600;
				opacity: 0.8;
			}
		</style>
		<script>
			import { initI18n, t } from '../i18n/index.ts';

			initI18n();
			// expose for nav script (same module singleton)
			window.__i18n = { t };

			async function loadNavUser() {
				try {
					const res = await fetch('/api/user');
					if (!res.ok) return;
					const user = await res.json();
					const list = document.getElementById('nav-user-list');
					if (!list) return;
					const items: string[] = [];
					if (user.display_name) items.push(`<li>${user.display_name}</li>`);
					if (!user.has_settings) {
						items.push(`<li><a href="/settings">${t('nav.setup')}</a></li>`);
					} else {
						items.push(`<li><a href="/settings">${t('nav.settings')}</a></li>`);
					}
					items.push(`<li><a href="/logout">${t('nav.logout')}</a></li>`);
					list.innerHTML = items.join('');
				} catch {}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', loadNavUser);
			} else {
				loadNavUser();
			}
		</script>
	</head>
	<body>
		<header class="container">
			<nav>
				<ul><li><a href="/" class="brand"><strong data-i18n="app.brand">Caley</strong></a></li></ul>
				<ul id="nav-user-list">
					<li><span data-i18n="nav.loading">Loading...</span></li>
				</ul>
			</nav>
		</header>
		<main class="container">
			<slot />
		</main>
	</body>
</html>

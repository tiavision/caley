---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <div class="settings-form">
        <div class="settings-header">
            <h2 data-i18n="settings.heading">Settings</h2>
            <div id="locale-picker-container"></div>
        </div>
        <p data-i18n="settings.subtitle">Configure your CalDAV connection to fetch calendar events.</p>
        <div id="settings-form-container"
             hx-get="/api/settings/form"
             hx-trigger="load"
             hx-swap="innerHTML">
            <p data-i18n="settings.subtitle">Loading...</p>
        </div>
    </div>
</Layout>

<script>
    import { createLocalePicker } from '../i18n/index.ts';
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('locale-picker-container')?.appendChild(createLocalePicker());
        });
    } else {
        document.getElementById('locale-picker-container')?.appendChild(createLocalePicker());
    }
</script>

<style>
    .settings-form { max-width: 32rem; margin: 2rem auto; }
    .settings-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .locale-picker { font-size: 0.875rem; padding: 0.125rem 1.5rem 0.125rem 0.5rem; margin: 0; background-color: var(--pico-form-element-background-color); color: var(--pico-form-element-color); border: var(--pico-border-width) solid var(--pico-form-element-border-color); border-radius: var(--pico-border-radius); font-family: inherit; cursor: pointer; }
    .error-msg { color: var(--pico-del-color); }
    .success-msg { color: var(--pico-ins-color); }
</style>

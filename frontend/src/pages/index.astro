---
import Calendar from '../components/Calendar.astro';
import Weekly from '../components/Weekly.astro';
import Layout from '../layouts/Layout.astro';
import Calendars from '../components/Calendars.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <div class="layout">
        <div class="calendar-picker"><Calendar /></div>
        <div class="calendar-list"><Calendars /></div>
        <div class="weekly"><Weekly /></div>
    </div>
</Layout>

<style>
.layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.calendar-picker {
    order: 1;
}

.weekly {
    order: 2;
}

.calendar-list {
    order: 3;
}

@media (min-width: 768px) {
    .layout {
        display: grid;
        grid-template-columns: minmax(auto, 28rem) 1fr;
        grid-template-areas:
            "picker list"
            "weekly weekly";
        gap: 1rem;
    }

    .calendar-picker {
        grid-area: picker;
        order: unset;
    }

    .calendar-list {
        grid-area: list;
        order: unset;
    }

    .weekly {
        grid-area: weekly;
        order: unset;
    }
}
</style>

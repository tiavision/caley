---

---

    <article class="card contrast" style="max-width: 28rem; margin: 2rem auto;">
      <header>
        <hgroup>
          <h1>January 2026</h1>
          <p>Monthly calendar view</p>
        </hgroup>
      </header>
      <div role="grid" aria-label="January 2026 calendar">
        <!-- Weekday headers using Pico grid -->
        <div class="grid date-grid" role="row">
          <small>Mon</small><small>Tue</small><small>Wed</small>
          <small>Thu</small><small>Fri</small><small>Sat</small><small>Sun</small>
        </div>
        <!-- Date grid -->
        <div class="grid date-grid" role="grid">
          <!-- 3 empty cells (Jan 1 is Thursday) -->
          <div class="date-cell empty"></div>
          <div class="date-cell empty"></div>
          <div class="date-cell empty"></div>
          <!-- Days 1-31 -->
          <div class="date-cell">1</div>
          <div class="date-cell">2</div>
          <div class="date-cell">3</div>
          <div class="date-cell"><span class="today">8</span></div>
          <div class="date-cell">9</div>
          <div class="date-cell">10</div>
          <div class="date-cell">11</div>
          <div class="date-cell">12</div>
          <div class="date-cell">13</div>
          <div class="date-cell">14</div>
          <div class="date-cell">15</div>
          <div class="date-cell">16</div>
          <div class="date-cell">17</div>
          <div class="date-cell">18</div>
          <div class="date-cell">19</div>
          <div class="date-cell">20</div>
          <div class="date-cell">21</div>
          <div class="date-cell">22</div>
          <div class="date-cell">23</div>
          <div class="date-cell">24</div>
          <div class="date-cell">25</div>
          <div class="date-cell">26</div>
          <div class="date-cell">27</div>
          <div class="date-cell">28</div>
          <div class="date-cell">29</div>
          <div class="date-cell">30</div>
          <div class="date-cell">31</div>
        </div>
      </div>
    </article>

<style>
    .date-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0;
    }
    .date-cell {
      padding: 0.75rem 0.25rem;
      text-align: center;
      border-bottom: 1px solid #ddd;
      border-right: 1px solid #ddd;
      min-height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .date-cell:nth-child(7n) {
      border-right: none;
    }
    .date-cell:nth-child(n+36) {
      border-bottom: none;
    }
    .today {
      background: var(--primary, #007bff);
      color: white;
      border-radius: 50%;
      font-weight: 600;
      width: 1.5rem;
      height: 1.5rem;
      margin: auto;
    }
    .empty {
      background: transparent;
      cursor: default;
    }
</style>